# Copy to .env (backend, repo root). NEVER commit .env.

# --- Safety / mode ---
DEMO_MODE=true
# true = log the SMS instead of sending. Set false only for the live demo.
DRY_RUN=true
# The ONLY phone the backend will ever alert (E.164, e.g. +14105551234). Email-to-SMS derives its address from this.
DEMO_PHONE_NUMBER=
RISK_THRESHOLD=0.5

# --- Stretch features (off by default; see docs/spec/00-overview.md) ---
# Needs `pip install -r requirements-ml.txt` (torch + transformers). Run on the demo laptop.
PHONEME_SCORING=false
# CPU threads for the phoneme model. Default is min(4, cores). Benchmarked on a 16-core laptop (5 s clip): 4 threads 0.77 s,
# 8 threads 0.45 s, 12+ threads ~0.39 s. Leave headroom for the browser during the demo; 8 is a good value on 8+ cores.
# PHONEME_THREADS=8

# --- Alert delivery ---
# email_sms = mail the carrier's text gateway through Gmail SMTP (free; no Twilio). twilio = legacy Twilio SMS (default).
# Setup steps (Gmail app password): docs/SMS-SETUP.md. Test: python scripts/sms_check.py
ALERT_CHANNEL=twilio
# Verizon = vtext.com. AT&T (June 2025) and T-Mobile (Dec 2024) shut their gateways down; Verizon's ends 2027-03-31.
SMS_GATEWAY_DOMAIN=vtext.com
SMTP_USER=
SMTP_APP_PASSWORD=

# --- Twilio (only if ALERT_CHANNEL=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional Spanish agent (a copy of the English one with docs/agent-prompt.es.md). Used when the site language is Spanish.
ELEVENLABS_AGENT_ID_ES=
# STT model used to transcribe the speech-test clip
ELEVENLABS_STT_MODEL=scribe_v1

# --- Gemini (vision second opinion; the free tier is enough. Get a key at https://aistudio.google.com/apikey) ---
# PRIVACY KILL SWITCH, default OFF. Only true/1/yes/on lets the backend send face/arm frames to Gemini. Off (or no key) means the
# second opinion is simply "unclear" and no network call is made. CAVEAT: on Google's FREE tier, submitted content is used to
# improve Google products and may be reviewed by humans, and developers are told not to submit personal information. A face photo
# is personal information, so keep this off for real users; enable only for a demo with consenting volunteers, or use a paid key.
SECOND_OPINION=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (frontend/.env.local) — public values only ---
# VITE_API_BASE_URL=http://localhost:8000
# VITE_ELEVENLABS_AGENT_ID=
