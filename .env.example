# Copy to .env (backend, repo root). NEVER commit .env.

# --- Safety / mode ---
DEMO_MODE=true
# true = log the call/SMS instead of sending. Set false only for the live demo.
DRY_RUN=true
# The ONLY number the backend will ever call/text (E.164, e.g. +14105551234).
DEMO_PHONE_NUMBER=
RISK_THRESHOLD=0.5

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# STT model used to transcribe the speech-test clip
ELEVENLABS_STT_MODEL=scribe_v1

# --- Anthropic (vision second opinion) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (frontend/.env.local) — public values only ---
# VITE_API_BASE_URL=http://localhost:8000
# VITE_ELEVENLABS_AGENT_ID=
