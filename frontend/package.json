{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "calibrate": "vitest run --config vitest.calibrate.config.ts",
    "tune": "vitest run --config vitest.tune.config.ts",
    "validate": "vitest run --config vitest.validate.config.ts",
    "freeze": "vitest run --config vitest.freeze.config.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.15.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
